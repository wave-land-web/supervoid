---
import '../styles/global.css'
import { Font } from 'astro:assets'
import Footer from '../components/layout/Footer.astro'
import Marquee from '../components/layout/Marquee.astro'
import Navigation from '../components/layout/Navigation.astro'
import { EMAIL, INSTAGRAM_URL, SITE_DESCRIPTION } from '../lib/site'
import type { SocialImage } from '../lib/socialImage'

export interface Props {
  /** The page's own name. " | SUPERVOID" is appended. */
  title: string
  description?: string
  /** Link-preview image, ideally 1200×630 (see socialImageFrom). Defaults to the site card. */
  socialImage?: SocialImage
  /** Describes the preview image, for platforms that read it out. */
  socialImageAlt?: string
  /** `article` for case studies and press posts. */
  ogType?: 'website' | 'article'
  /** JSON-LD nodes for this page, added to the site-wide Organization and WebSite. */
  schema?: Record<string, unknown>[]
  /** Load the Mux Player script, for the full player on /reel. Clips elsewhere use CoverVideo. */
  mux?: boolean
  /** Leave out the nav, marquee and footer (the /reel splash page). */
  minimal?: boolean
  /** Keep the page out of search results (utility pages). */
  noindex?: boolean
}

const {
  title,
  description = SITE_DESCRIPTION,
  socialImage = { src: '/images/og-image.png', width: 1920, height: 1080 },
  socialImageAlt = 'SUPERVOID',
  ogType = 'website',
  schema = [],
  mux = false,
  minimal = false,
  noindex = false,
} = Astro.props
const pageTitle = `${title} | SUPERVOID`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(socialImage.src, canonicalURL)

// Structured data: who SUPERVOID is on every page, plus whatever the page adds.
// Pages reference the organization by its @id.
const site = Astro.site?.href ?? canonicalURL.origin
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'SUPERVOID',
      url: site,
      logo: new URL('/android-chrome-512x512.png', site).href,
      description: SITE_DESCRIPTION,
      email: EMAIL,
      sameAs: [INSTAGRAM_URL],
      knowsAbout: ['Screen visuals', 'Lighting design', 'Lasers', 'Scenic design', 'Show control'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      name: 'SUPERVOID',
      url: site,
      publisher: { '@id': `${site}#organization` },
    },
    ...schema,
  ],
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Reveal-system gate: mark scripting live so the `.lsa` hidden state (in
         global.css) only applies when JS can lift it again. With JS disabled or
         failing, `.lsa` content stays visible instead of a blank page. Inline +
         synchronous so it runs before first paint (no flash of visible text). -->
    <script is:inline>
      document.documentElement.classList.add('lsa-on')
    </script>
    <!-- SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <!-- Only pages in search get a canonical URL; the 404 page has no address of its own -->
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonicalURL} />
    )}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Facebook -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="SUPERVOID" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="supervoid.tv" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" content="#000000" />

    <!-- Declared here as well as in CSS (`html { color-scheme }`). The browser
         paints a canvas during a navigation, before the new document's
         stylesheet has been parsed — at that point the CSS declaration doesn't
         exist yet, so it falls back to light and can flash white between pages.
         A meta tag is read straight from the head, so the very first paint is
         already dark. -->
    <meta name="color-scheme" content="dark" />

    <!-- Preload Fonts -->
    <Font cssVariable="--font-rotonto" preload />
    <Font cssVariable="--font-sf-mono" preload />

    <!-- Mux — opted into by pages that render a video player -->
    {mux && <script src="https://cdn.jsdelivr.net/npm/@mux/mux-player" is:inline async />}

    <!-- Umami Analytics -->
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="50a25800-0106-435f-b0ae-27a89f5ef36b"
    ></script>
  </head>

  <body class="font-body bg-black text-white">
    {!minimal && (
      <a
        href="#content"
        class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-1 focus:rounded-full focus:bg-magenta focus:text-black text-xs uppercase"
      >
        Skip to content
      </a>
    )}
    <!-- The bottom margin uncovers the fixed footer underneath as the page ends -->
    <div id="wrapper" class:list={['relative z-10 bg-black', !minimal && 'mb-96']}>
      {!minimal && <Navigation />}
      <main>
        <!-- Skip link target, at the top of the page's own content -->
        <div id="content" tabindex="-1" class="outline-none"></div>
        <slot />
      </main>
      {!minimal && <Marquee />}
    </div>
    {!minimal && <Footer />}
  </body>
</html>

<script is:inline>
  /**
   * Animate sections with the class `lsa` when they come into view
   */
  function handleAnimations() {
    const sections = document.querySelectorAll('.lsa')
    if (sections.length === 0) return

    // No IntersectionObserver (a very old browser): reveal everything up front
    // so content is never left stuck behind the `.lsa` hidden state.
    if (!('IntersectionObserver' in window)) {
      for (const section of sections) section.classList.add('active')
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const section = entry.target

          // By default, animations repeat on scroll unless the section has the class `no-repeat`
          if (entry.isIntersecting) {
            section.classList.add('active')
            // Play-once elements never change again — stop watching them so the
            // callback doesn't keep firing for already-revealed content.
            if (section.classList.contains('no-repeat')) observer.unobserve(section)
          } else if (!section.classList.contains('no-repeat')) {
            section.classList.remove('active')
          }
        }
      },
      // Fire as soon as the element's top edge crosses into the bottom 90% of
      // the viewport (threshold 0 + a -10% bottom margin), so a reveal starts
      // once the element is meaningfully on screen rather than at its first
      // pixel. Height-independent: a `threshold` fraction would never be
      // reached by an element taller than ~1/threshold viewports, leaving it
      // stuck hidden.
      { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0 },
    )

    for (const section of sections) observer.observe(section)
  }

  // This script is the last node in the document, so every `.lsa` element is
  // already parsed. Run now instead of on DOMContentLoaded, which is blocked
  // until every deferred bundle has downloaded and executed. Above-the-fold
  // content doesn't wait on this at all — it uses the CSS-only `lsa-load`.
  handleAnimations()
</script>
