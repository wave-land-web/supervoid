---
import '../styles/global.css'
import Marquee from '../components/ui/Marquee.astro'
import Navigation from '../components/ui/Navigation.astro'
import Footer from '../components/ui/Footer.astro'
import { Font } from 'astro:assets'

export interface Props {
  title: string
  description?: string
  socialImage?: string
  /** Load the Mux player script. Only set on pages that render <mux-player>. */
  mux?: boolean
  /** Load the YouTube IFrame API. Only set on pages with lighting cards. */
  youtube?: boolean
}

const {
  title,
  description = 'SUPERVOID is a creative and technical design studio specializing in screen visuals, lighting, lasers, scenic design and custom control setups for touring artists.',
  socialImage,
  mux = false,
  youtube = false,
} = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
const socialImageURL = new URL(socialImage || '/images/og-image.png', canonicalURL)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Reveal-system gate: mark scripting live so the `.lsa` hidden state (in
         global.css) only applies when JS can lift it again. With JS disabled or
         failing, `.lsa` content stays visible instead of a blank page. Inline +
         synchronous so it runs before first paint (no flash of visible text). -->
    <script is:inline>
      document.documentElement.classList.add('lsa-on')
    </script>

    <!-- SEO -->
    <title>SUPERVOID | {title}</title>
    <meta name="title" content={`SUPERVOID | ${title}`} />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Facebook -->
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`SUPERVOID | ${title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="supervoid.tv" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={`SUPERVOID | ${title}`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageURL} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#000000" />
    <meta name="msapplication-TileColor" content="#000000" />
    <meta name="theme-color" content="#000000" />

    <!-- Declared here as well as in CSS (`html { color-scheme }`). The browser
         paints a canvas during a navigation, before the new document's
         stylesheet has been parsed — at that point the CSS declaration doesn't
         exist yet, so it falls back to light and can flash white between pages.
         A meta tag is read straight from the head, so the very first paint is
         already dark. -->
    <meta name="color-scheme" content="dark" />

    <!-- Preload Fonts -->
    <Font cssVariable="--font-header" preload />
    <Font cssVariable="--font-body" preload />

    {/* YouTube API — opted into by pages that embed YouTube players */}
    {youtube && <script src="https://www.youtube.com/iframe_api" is:inline async />}

    {/* Mux — opted into by pages that render a video player */}
    {mux && <script src="https://cdn.jsdelivr.net/npm/@mux/mux-player" is:inline async />}

    <!-- Umami Analytics -->
    <script
      type="text/partytown"
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="50a25800-0106-435f-b0ae-27a89f5ef36b"></script>
  </head>

  <body class="font-body bg-black text-white">
    <div id="wrapper" class="relative z-10 mb-96 bg-black">
      <div class="max-w-screen-2xl mx-auto">
        {!Astro.url.pathname.includes('/reel') && <Navigation />}
        <slot name="video-slot" />
      </div>
      <slot />
      {!Astro.url.pathname.includes('/reel') && <Marquee />}
    </div>
    {!Astro.url.pathname.includes('/reel') && <Footer />}
  </body>
</html>

<script is:inline>
  /**
   * Animate sections with the class `lsa` when they come into view
   */
  function handleAnimations() {
    const sections = document.querySelectorAll('.lsa')
    if (sections.length === 0) return

    // No IntersectionObserver (a very old browser): reveal everything up front
    // so content is never left stuck behind the `.lsa` hidden state.
    if (!('IntersectionObserver' in window)) {
      for (const section of sections) section.classList.add('active')
      return
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const section = entry.target

          // By default, animations repeat on scroll unless the section has the class `no-repeat`
          if (entry.isIntersecting) {
            section.classList.add('active')
            // Play-once elements never change again — stop watching them so the
            // callback doesn't keep firing for already-revealed content.
            if (section.classList.contains('no-repeat')) observer.unobserve(section)
          } else if (!section.classList.contains('no-repeat')) {
            section.classList.remove('active')
          }
        }
      },
      // Fire as soon as the element's top edge crosses into the bottom 90% of
      // the viewport (threshold 0 + a -10% bottom margin), so a reveal starts
      // once the element is meaningfully on screen rather than at its first
      // pixel. Height-independent: a `threshold` fraction would never be
      // reached by an element taller than ~1/threshold viewports, leaving it
      // stuck hidden.
      { root: null, rootMargin: '0px 0px -10% 0px', threshold: 0 },
    )

    for (const section of sections) observer.observe(section)
  }

  // This script is the last node in the document, so every `.lsa` element is
  // already parsed. Run now instead of on DOMContentLoaded, which is blocked
  // until every deferred bundle has downloaded and executed. Above-the-fold
  // content doesn't wait on this at all — it uses the CSS-only `lsa-load`.
  handleAnimations()
</script>
