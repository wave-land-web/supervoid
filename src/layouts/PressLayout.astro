---
import type { CollectionEntry } from 'astro:content'
import PageHeader from '../components/layout/PageHeader.astro'
import Pagination from '../components/ui/Pagination.astro'
import { socialImageFrom } from '../lib/socialImage'
import Layout from './Layout.astro'

export interface Props {
  post: CollectionEntry<'press'>
  prevPost?: CollectionEntry<'press'>
  nextPost?: CollectionEntry<'press'>
}

const { post, prevPost, nextPost } = Astro.props
const { title, description, image, imageAlt } = post.data

const socialImage = await socialImageFrom(image)
const url = new URL(Astro.url.pathname, Astro.site).href

const schema = [
  {
    '@type': 'Article',
    '@id': `${url}#article`,
    headline: `${title} press highlights`,
    description,
    url,
    image: new URL(socialImage.src, Astro.site).href,
    datePublished: post.data.published.toISOString().slice(0, 10),
    author: { '@id': `${Astro.site}#organization` },
    publisher: { '@id': `${Astro.site}#organization` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Press',
        item: new URL('/press/', Astro.site).href,
      },
      { '@type': 'ListItem', position: 3, name: title, item: url },
    ],
  },
]
---

<Layout
  title={`${title} | Press`}
  description={description}
  socialImage={socialImage}
  socialImageAlt={imageAlt}
  ogType="article"
  schema={schema}
>
  <PageHeader title={title} image={{ src: image, alt: imageAlt }} narrow />

  <div
    id="press-layout"
    class="page-body max-w-4xl flex flex-col gap-[1lh] mb-16 md:mb-24 lsa no-repeat"
  >
    <slot />

    <Pagination
      prev={prevPost && { href: `/press/${prevPost.id}/`, title: prevPost.data.title }}
      next={nextPost && { href: `/press/${nextPost.id}/`, title: nextPost.data.title }}
    />
  </div>
</Layout>
