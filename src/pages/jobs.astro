---
import jobsHeroImage from '../assets/jobs-hero.jpg'
import PageHeader from '../components/layout/PageHeader.astro'
import Carousel from '../components/media/Carousel.astro'
import Button from '../components/ui/Button.astro'
import CheckList from '../components/ui/CheckList.astro'
import SplitRow from '../components/ui/SplitRow.astro'
import jobsCarouselOneImage from '../content/work/images/SVX_Horizontal_0002_Radiohead 15.jpg'
import jobsCarouselTwoImage from '../content/work/images/SVX_Horizontal_0016_Radiohead 1.jpg'
import jobsCarouselThreeImage from '../content/work/images/SVX_Horizontal_0018_STS9 7.jpg'
import jobsCarouselFourImage from '../content/work/images/SVX_Horizontal_0024_STS9 1.jpg'
import jobsCarouselFiveImage from '../content/work/images/SVX_Horizontal_0026_Couch 7.jpg'
import jobsCarouselSixImage from '../content/work/images/SVX_Horizontal_0028_Couch 5.jpg'
import Layout from '../layouts/Layout.astro'
import { EMAIL, mailto } from '../lib/site'
import { socialImageFrom } from '../lib/socialImage'
---

<Layout
  title="Jobs"
  description="Apply to join the SUPERVOID team. We're looking for passionate and innovative individuals who want to make something no one has ever seen before."
  socialImage={await socialImageFrom(jobsHeroImage)}
>
  <PageHeader
    title="Join Our Team"
    image={{
      src: jobsHeroImage,
      alt: 'Tyler Childers at Madison Square Garden',
      caption: 'Tyler Childers at Madison Square Garden - Video Content by SUPERVOID',
    }}
  />

  <!-- Clip sideways: the card carousel's stacked slides overflow its box from md up -->
  <div class="page-body overflow-x-clip">
    <section class="lsa lsa-slide-up no-repeat pt-4 pb-8">
      <SplitRow label="OUR PHILOSOPHY">
        <div>
          <p class="mb-4 text-m">
            We started SUPERVOID to make the kind of shows that we want to see{' '}
            <span class="text-magenta">as fans</span>.
          </p>
          <p class="text-grey">
            We foster an environment where offbeat ideas can flourish, collaboration is key, and
            everyone's taste and vision is considered, no matter your job title or level of
            experience. Our team is dedicated to taking our wildest ideas and turning them into
            practical realities.
          </p>
        </div>
      </SplitRow>
    </section>

    <section class="max-w-3xl xl:max-w-7xl m-auto grid xl:grid-cols-2 gap-16 md:gap-24 lsa lsa-slide-up no-repeat">
      <Carousel
        images={[
          { src: jobsCarouselOneImage, alt: '' },
          { src: jobsCarouselTwoImage, alt: '' },
          { src: jobsCarouselThreeImage, alt: '' },
          { src: jobsCarouselFourImage, alt: '' },
          { src: jobsCarouselFiveImage, alt: '' },
          { src: jobsCarouselSixImage, alt: '' },
        ]}
        class="self-center order-1 md:order-0"
      />

      <div class="flex flex-col justify-center gap-8">
        <h2 class="text-l uppercase">Who We're Looking For</h2>
        <p class="text-grey">
          We're always on the lookout for passionate and innovative individuals who:
        </p>
        <CheckList
          items={[
            'Have a strong portfolio demonstrating their skills and creativity.',
            'Are team players who thrive in a collaborative environment.',
            "Are eager to learn and push the limits of what's possible in animation, VFX, lighting, and stage design.",
            'Bring unique perspectives and ideas to the table.',
          ]}
        />
      </div>
    </section>

    <section class="max-w-xl m-auto flex flex-col items-center gap-8 text-center lsa lsa-slide-up no-repeat">
      <h2 class="text-l uppercase">Join Our Team</h2>
      <p>
        If you want to make something no one has ever seen before and contribute to innovative
        projects, we'd love to hear from you. Please submit your resume to{' '}
        <a href={mailto('Supervoid Job Application')} class="site-link">
          {EMAIL}
        </a>
        , and we'll reach out if there's a fit.
      </p>

      <Button href={mailto('Supervoid Job Application')} text="Apply Now" />
    </section>
  </div>
</Layout>
