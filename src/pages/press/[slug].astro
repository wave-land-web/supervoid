---
import { getCollection, render } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'
import PressLayout from '../../layouts/PressLayout.astro'
import { sortPressNewestFirst } from '../../lib/sortPress'

export async function getStaticPaths() {
  const posts = sortPressNewestFirst(await getCollection('press'))

  return posts.map((post, index) => ({
    params: { slug: post.id },
    props: { post, prevPost: posts[index - 1], nextPost: posts[index + 1] },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post, prevPost, nextPost } = Astro.props
const { Content } = await render(post)
---

<PressLayout post={post} prevPost={prevPost} nextPost={nextPost}>
  <Content />
</PressLayout>
