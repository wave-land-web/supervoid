---
import aboutHeroImage from '../assets/about-hero.jpg'
import verticalRadiohead from '../assets/vertical-images/SVX_Vertical_0000_Radiohead 1.jpg'
import verticalSts9Five from '../assets/vertical-images/SVX_Vertical_0001_STS9 5.jpg'
import verticalSts9Four from '../assets/vertical-images/SVX_Vertical_0002_STS9 4.jpg'
import verticalSts9Three from '../assets/vertical-images/SVX_Vertical_0003_STS9 3.jpg'
import verticalSts9Two from '../assets/vertical-images/SVX_Vertical_0004_STS9 2.jpg'
import verticalSts9One from '../assets/vertical-images/SVX_Vertical_0005_STS9 1.jpg'
import verticalCouchFour from '../assets/vertical-images/SVX_Vertical_0006_Couch 4.jpg'
import verticalCouchThree from '../assets/vertical-images/SVX_Vertical_0007_Couch 3.jpg'
import verticalCouchTwo from '../assets/vertical-images/SVX_Vertical_0008_Couch 2.jpg'
import verticalCouchOne from '../assets/vertical-images/SVX_Vertical_0009_Couch 1.jpg'
import PageHeader from '../components/layout/PageHeader.astro'
import VerticalCarousel from '../components/media/VerticalCarousel.astro'
import Button from '../components/ui/Button.astro'
import SplitRow from '../components/ui/SplitRow.astro'
import Layout from '../layouts/Layout.astro'
import { socialImageFrom } from '../lib/socialImage'

// What we do, one list per discipline
const SERVICES = [
  {
    title: 'Production Design',
    items: ['Set Design', 'Lighting Design', 'Video Design', 'Camera Layout', 'Production Support'],
  },
  {
    title: 'Screen Visuals',
    items: [
      'Full service from concept to delivery',
      '2D and 3D Graphics',
      'Notch + IMAG',
      'Filmed content',
      'Full previs capability',
    ],
  },
  {
    title: 'Lighting Design',
    items: ['Plot Creation', 'Rendering', 'Programming (MA2 + MA3)', 'Full previs capability'],
  },
]
---

<Layout title="About" socialImage={await socialImageFrom(aboutHeroImage)}>
  <PageHeader
    title="Crafting Visual Experiences"
    image={{
      src: aboutHeroImage,
      alt: 'Radiohead at Madrid with Supervoid-designed screen visuals and lighting.',
      caption: 'Radiohead, live in Madrid, 2025.',
    }}
  />

  <div class="page-body">
    <section id="who-we-are" class="lsa lsa-slide-up no-repeat pt-4 pb-8">
      <SplitRow label="Who We Are">
        <div class="flex flex-col gap-4">
          <p class="text-m">
            <span class="text-magenta inline-block lsa lsa-slide-up no-repeat delay-50">
              SUPERVOID
            </span>{' '}
            is a design practice specializing in{' '}
            <span class="text-magenta inline-block lsa lsa-slide-up no-repeat delay-100">
              creative, dynamic,
            </span>{' '}
            and{' '}
            <span class="text-magenta inline-block lsa lsa-slide-up no-repeat delay-150">
              interactive media.
            </span>
          </p>
          <p class="text-grey-light">
            We use our expertise in the creative and technical aspects of live production to elevate
            our clients' shows. We create{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-200">
              stunning visuals
            </span>{' '}
            that work with scalable productions, build custom controls to allow a client to affect
            their visuals from{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-250">
              any device,
            </span>{' '}
            and design{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-300">
              lighting and laser shows
            </span>{' '}
            that leave audiences with their jaws on the floor.
          </p>
          <p class="text-grey-light">
            Everything we do we do with one{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-350">
              mission
            </span>{' '}
            in mind:
          </p>
          <p class="text-grey-light">
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-400">Create</span>{' '}
            something you'll never forget, that{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-450">
              highlights your work
            </span>{' '}
            instead of distracting from it, and build it in a way that is{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-500">
              efficient
            </span>{' '}
            and{' '}
            <span class="text-white inline-block lsa lsa-slide-up no-repeat delay-550">
              reliable.
            </span>
          </p>
        </div>
      </SplitRow>
    </section>

    <section id="services">
      <h2 class="sr-only">Services</h2>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-16">
        {SERVICES.map(({ title, items }, index) => (
          <div
            class:list={[
              'lsa lsa-slide-up no-repeat',
              index === 1 && 'delay-100',
              index === 2 && 'delay-200',
            ]}
          >
            <h3 class="mb-4 text-m text-magenta uppercase">{title}</h3>
            <ul>
              {items.map((item) => (
                <li class="flex gap-4">
                  <span aria-hidden="true">-</span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section id="join-our-team" class="m-auto xl:py-32 lsa lsa-slide-up no-repeat">
      <VerticalCarousel
        images={[
          { src: verticalRadiohead, alt: '' },
          { src: verticalSts9Five, alt: '' },
          { src: verticalSts9Four, alt: '' },
          { src: verticalSts9Three, alt: '' },
          { src: verticalSts9Two, alt: '' },
          { src: verticalSts9One, alt: '' },
          { src: verticalCouchFour, alt: '' },
          { src: verticalCouchThree, alt: '' },
          { src: verticalCouchTwo, alt: '' },
          { src: verticalCouchOne, alt: '' },
        ]}
      />

      <div class="flex flex-col items-center justify-center gap-6 p-8 xl:p-12 text-center">
        <h2 class="text-l uppercase text-stroke">Join Our Team</h2>
        <p>
          We're always on the lookout for talented individuals to join our team. If you're
          passionate about animation, VFX, and design, and want to work on exciting projects, check
          out our current openings and become part of the Supervoid family.
        </p>

        <Button href="/jobs/" text="Explore Careers" class="mx-auto xl:mx-0" />
      </div>
    </section>
  </div>
</Layout>
