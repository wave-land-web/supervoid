---
import { getCollection } from 'astro:content'
import CTA from '../components/text/CTA.astro'
import LightingPreviewCard from '../components/ui/LightingPreviewCard.astro'
import WorkPreviewCard from '../components/ui/WorkPreviewCard.astro'
import YearHeading from '../components/ui/YearHeading.astro'
import Layout from '../layouts/Layout.astro'
import { getAlphabetizedWorkByYear, getWorkYearsDescending } from '../utils/sortWork'

// Get the video and lighting work data
const videoWorkData = await getCollection('work')
const lightingWorkData = await getCollection('lighting')

// Combine both collections
const allWork = [...videoWorkData, ...lightingWorkData]

// Group by year, newest first — years come from the content, not a hardcoded list
const workByYear = getWorkYearsDescending(allWork).map((year) => ({
  year,
  work: getAlphabetizedWorkByYear({ allWork, year }),
}))
---

<Layout title="Screen Visuals, Lighting, Lasers & Scenic Design for Touring Artists" youtube>
  <header class="pt-[calc(var(--nav-height)+2rem)]">
    {/* `hero-in` cascades these three children in DOM order — no per-element delays */}
    <div id="header-content" class="hero-in flex flex-col gap-6">
      <h1 class="text-xl md:text-2xl lg:text-3xl mb-4">
        SUPERVOID <br />
        <span class="block text-m text-magenta-900">designs shows.</span>
      </h1>

      <p class="max-w-3xl text-balance text-base">
        We deliver end-to-end creative direction for live shows—designing unforgettable stages,
        visuals, and moments that bring an artist's vision to life.
      </p>

      <div>
        <CTA text="Contact Us Today" href="/contact" />
      </div>
    </div>
  </header>

  <main id="work" class="relative w-full">
    {
      workByYear.map(({ year, work }, yearIndex) => (
        <section id={year}>
          <YearHeading year={year} />
          <div class="lsa-stagger grid md:grid-cols-2 md:gap-x-10 gap-y-8 md:gap-y-12">
            {work.map((item, itemIndex) => {
              // The first row lands in the fold — one card on phones, two once
              // the grid splits at `md`. Those animate from CSS instead of
              // waiting on the scroll observer.
              const isAboveTheFold = yearIndex === 0 && itemIndex < 2

              return item.collection === 'work' ? (
                <WorkPreviewCard work={item} isAboveTheFold={isAboveTheFold} />
              ) : (
                <LightingPreviewCard work={item} isAboveTheFold={isAboveTheFold} />
              )
            })}
          </div>
        </section>
      ))
    }
  </main>
</Layout>
