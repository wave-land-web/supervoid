---
import { getCollection } from 'astro:content'
import PressCard from '../components/cards/PressCard.astro'
import Layout from '../layouts/Layout.astro'
import { sortPressNewestFirst } from '../lib/sortPress'

const sortedPressPosts = sortPressNewestFirst(await getCollection('press'))
// The newest two fill the first row, which is above the fold
const ABOVE_THE_FOLD_COUNT = 2
---

<Layout
  title="Press"
  description="Get a quick look at our latest projects, artist collabs, and highlights."
>
  <header class="pt-[calc(var(--nav-height)+6rem)] lsa-load lsa-slide-up">
    <h1 class="text-xl mb-4 drop-shadow-lg text-center uppercase">Press & Media</h1>
    <p class="mx-auto text-center text-grey-100">
      Get a quick look at our latest projects, artist collabs, and highlights. Click an image to
      learn more.
    </p>
  </header>

  <div class="page-body">
    <section class="lsa-stagger grid md:grid-cols-2 gap-x-10 gap-y-12">
      {sortedPressPosts.map((post, index) => (
        <PressCard
          post={post}
          isAboveTheFold={index < ABOVE_THE_FOLD_COUNT}
          priority={index === 0}
        />
      ))}
    </section>
  </div>
</Layout>
