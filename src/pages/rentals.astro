---
import { Picture } from 'astro:assets'
import grandma3CompactImage from '../assets/grandma3-compact.png'
import rentalsHeroImage from '../assets/rentals-hero.webp'
import willowImage from '../assets/rentals-willow.webp'
import svxSeriesServerBackImage from '../assets/svx-series-server-back.png'
import PageHeader from '../components/layout/PageHeader.astro'
import Button from '../components/ui/Button.astro'
import CheckList from '../components/ui/CheckList.astro'
import SplitRow from '../components/ui/SplitRow.astro'
import Layout from '../layouts/Layout.astro'
import { mailto } from '../lib/site'
import { socialImageFrom } from '../lib/socialImage'
---

<Layout
  title="Rentals"
  description="SUPERVOID offers show control solutions for video playback and lighting control. Our SVX series servers and GrandMA3 Compact consoles are trusted by Paramore, Tate McRae, Jane's Addiction, and more."
  socialImage={await socialImageFrom(rentalsHeroImage)}
>
  <PageHeader
    title="Powering Your Performance"
    image={{
      src: rentalsHeroImage,
      alt: 'Paramore on the Eras tour',
      caption:
        'Paramore at 2024 iHeartRadio Music Festival - Visuals powered by SUPERVOID SVX-1 Series Servers.',
    }}
  />

  <div class="page-body">
    <section class="pt-4 pb-8">
      <SplitRow label="Trusted by" class="lsa lsa-slide-up no-repeat">
        <p class="mb-4 text-m">
          Alex Warren. Sheryl Crow. Paramore. Tate McRae. Jane's Addiction. Dan + Shay. Willow. Elle
          King. All Time Low. Chloe Moriondo. STS9. Cuco. Underoath. Taking Back Sunday. Wage War.
          Motion City Soundtrack. Love and Rockets. Spiritbox. San Holo. Five Finger Death Punch.
          Trans-Siberian Orchestra. Poppy. The Wonder Years. Cage The Elephant. Cavetown.
        </p>
      </SplitRow>

      <SplitRow label="Show Control Solutions" class="lsa lsa-slide-up no-repeat">
        <div class="flex flex-col gap-4">
          <p class="text-grey">
            Custom video content and beautiful lighting design don't do much for a show without
            elegant solutions for playback and control.
          </p>
          <p class="text-grey max-w-[66ch]">
            For video playback and IMAG FX, we've designed the SUPERVOID SVX-1 Media Server to meet
            the needs of shows large and small. Our media servers are tremendously powerful and can
            run the biggest shows without needing the biggest budgets.
          </p>
          <p class="text-grey">
            For lighting control, we've invested in MA Lighting's GrandMA3 Compact console. These
            are the most cost-efficient of the MA3 series, enabling our clients to run shows from
            arenas to clubs. They empower Lighting Directors with the powerful MA3 platform in a
            package that's small enough to fly with and budget-friendly for the smaller tours. The
            MA3 compact perfectly fits with the philosophy we've aligned ourselves with in our media
            server platform - meet the needs of shows large and small, without compromising artistic
            value.
          </p>
        </div>
      </SplitRow>
    </section>

    <section class="max-w-3xl lg:max-w-7xl m-auto grid lg:grid-cols-2 gap-16 lg:gap-0 lsa lsa-slide-up no-repeat">
      <figure class="lg:translate-x-2">
        <Picture
          src={willowImage}
          formats={['avif', 'webp']}
          sizes="(min-width: 1024px) 608px, (min-width: 832px) 768px, calc(100vw - 32px)"
          alt="Willow at Camp Flog Gnaw"
        />
        <figcaption class="text-center mt-4 mx-auto text-2xs text-grey">
          Willow at Camp Flog Gnaw
        </figcaption>
      </figure>

      <div class="self-center h-fit p-8 lg:p-12 lg:-translate-x-2 rounded-xl z-10 bg-magenta text-black text-center lg:text-left">
        <p>
          For years we programmed media servers that cost several thousands of dollars per week to
          rent, which prohibited some of our clients from bringing them on their tours, so we made
          our own solution. Our SVX series servers are powerful enough to run big shows without
          breaking the bank.
        </p>
      </div>
    </section>

    <!-- Servers -->

    <section
      id="servers"
      class="flex flex-col items-center gap-16 lg:gap-24 lsa lsa-slide-up no-repeat"
    >
      <h2 class="text-l text-center uppercase">SVX Series Servers Quick Specs</h2>

      <div class="max-w-3xl lg:max-w-7xl m-auto grid lg:grid-cols-2 items-start justify-items-center gap-24 md:gap-32">
        <Picture
          src={svxSeriesServerBackImage}
          sizes="(min-width: 640px) 384px, calc(100vw - 160px)"
          formats={['avif', 'webp']}
          alt="SVX Series Servers - Back"
          class="px-16 py-12 max-w-lg"
        />

        <div class="flex flex-col justify-center gap-8">
          <h3 class="text-base uppercase">Description</h3>
          <div id="servers-description" class="flex flex-col gap-8">
            <p class="text-grey">
              Our 2RU Fly Rack Kits contain everything you need to run your show. Rentals start as
              low as $500/week, with 24/7 tech support and SUPERVOID exclusive VJ loops and visual
              content included in every rental.
            </p>
            <CheckList
              items={[
                'Run up to 12 HD screens, 3 4K screens, or even a single 8K screen, with a dedicated GUI for controlling the software',
                'Capture up to 4 HD inputs or one 4K input over SDI or HDMI',
                'Real-time low latency visual effects with Notch built into each server',
                'Pixel map and control hundreds of universes of lights over artnet',
                'Control via your lighting desk with artnet or from MIDI or OSC',
                'Remote control over LAN/Wifi from any Windows or Mac computer',
              ]}
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Lighting -->

    <section id="lighting" class="flex flex-col items-center gap-16 lsa lsa-slide-up no-repeat">
      <h2 class="text-l text-center uppercase">GrandMA3 Compact Quick Specs</h2>

      <div class="max-w-3xl lg:max-w-7xl m-auto grid lg:grid-cols-2 items-start justify-items-center gap-24 md:gap-32">
        <Picture
          src={grandma3CompactImage}
          sizes="(min-width: 640px) 384px, calc(100vw - 160px)"
          formats={['avif', 'webp']}
          alt="GrandMA3 Compact Lighting Console"
          class="px-16 py-12 max-w-lg"
        />

        <div class="flex flex-col justify-center gap-8">
          <h3 class="text-base uppercase">Description</h3>
          <div id="lighting-description" class="flex flex-col gap-8">
            <p class="text-grey">
              The grandMA3 compact console is a portable, professional lighting control system,
              ideal for small to medium events. It offers customizable features, intuitive dual
              encoders, and seamless compatibility with grandMA2 and grandMA3 software.
            </p>
            <CheckList
              items={[
                'Control up to 250,000 parameters with grandMA3 processing units',
                '6 DMX outputs, 1 DMX input, and 3 etherCON connectors',
                'Foldable internal multi-touch screen with external screen support',
                '29 backlit rotary encoders, 5 dual encoders, and 40 playbacks',
                '10 motorized 60 mm faders and 2 motorized A/B faders (100 mm)',
                'Silent, backlit keys and 16 assignable x-keys for smooth control',
              ]}
            />
          </div>
        </div>
      </div>
      <Button href={mailto('Rentals Inquiry')} text="Rent Now" />
    </section>
  </div>
</Layout>
