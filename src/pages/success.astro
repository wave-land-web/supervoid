---
import PageHeader from '../components/layout/PageHeader.astro'
import Button from '../components/ui/Button.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="Message Sent" noindex>
  <PageHeader title="Success!" />

  <div class="page-body">
    <section class="max-w-xl m-auto pt-0 text-center lsa-load lsa-slide-up [animation-delay:300ms]">
      <p class="mb-8 text-base">
        Your message has been sent. We'll get back to you as soon as possible.
      </p>
      <Button text="Back to Home" href="/" class="mx-auto" />
    </section>
  </div>
</Layout>
