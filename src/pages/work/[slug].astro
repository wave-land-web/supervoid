---
import { Picture } from "astro:assets";
import { type CollectionEntry, getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import Pagination from "../../components/ui/Pagination.astro";
import Layout from "../../layouts/Layout.astro";
import {
  getAlphabetizedWorkByYear,
  getWorkYearsDescending,
} from "../../utils/sortWork";
import { toMetaDescription } from "../../utils/text";

export async function getStaticPaths() {
  const allPosts = await getCollection("work");

  // Build sorted list by year (newest first), then alphabetically within each year.
  // Years are derived from the content so no entry can be missed.
  const sortedPosts = getWorkYearsDescending(allPosts).flatMap((year) =>
    getAlphabetizedWorkByYear({ allWork: allPosts, year }),
  );

  return sortedPosts.map((post, index) => ({
    params: {
      slug: post.id,
    },
    props: {
      post: post as CollectionEntry<"work">,
      prevPost: sortedPosts[index - 1],
      nextPost: sortedPosts[index + 1],
    },
  }));
}

const { post, prevPost, nextPost } = Astro.props;

// Only pull in the Mux player script on entries that actually render one
const hasMuxVideo = Boolean(
  post.data.gifs.videoHero || post.data.gifs.gallery?.length,
);

// First frame of the hero video, shown until the player fades in over it
// (`time=0`: Mux's default thumbnail is mid-clip)
const heroStill = (width: number) =>
  `https://image.mux.com/${post.data.gifs.videoHero}/thumbnail.webp?width=${width}&time=0`;
const heroStillWidths = [768, 1280, 1920];
---

<Layout
  title={`Work - ${post.data.title}`}
  description={toMetaDescription(post.data.info[0])}
  mux={hasMuxVideo}
>
  <div slot="video-slot" class="relative lsa-load">
    <div
      class="relative aspect-video w-full after:content-[''] after:absolute after:inset-0 after:bg-linear-to-b after:from-transparent after:to-black after:pointer-events-none"
    >
      {
        post.data.gifs.videoHero ? (
          <>
            <img
              src={heroStill(1920)}
              srcset={heroStillWidths
                .map((w) => `${heroStill(w)} ${w}w`)
                .join(", ")}
              sizes="(min-width: 1536px) 1536px, 100vw"
              alt={post.data.title}
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="absolute inset-0 size-full object-cover pointer-events-none"
            />
            {/* The still replaces Mux's poster; nothing buffers until playback */}
            <mux-player
              id="hero-video"
              playback-id={post.data.gifs.videoHero}
              metadata-video-title={`Supervoid Work Page: ${post.data.title}`}
              accent-color="var(--color-magenta-900)"
              class="absolute inset-0 size-full opacity-0 transition-opacity duration-500 data-playing:opacity-100"
              style="--controls: none;"
              poster=""
              preload="none"
              loop
              muted
              playsinline
            />
          </>
        ) : post.data.gifs.imageHero ? (
          /* Above-the-fold hero: the LCP element, so fetch it immediately */
          <Picture
            src={post.data.gifs.imageHero}
            alt={post.data.title}
            loading="eager"
            fetchpriority="high"
            class="absolute top-0 left-0 w-full h-full object-cover"
          />
        ) : null
      }

      {
        post.data.gifs.videoHero && (
          <div class="absolute bottom-4 md:bottom-8 right-4 md:right-8 flex flex-col lg:flex-row gap-4 lg:gap-6 z-10">
            <button
              id="toggle-play"
              type="button"
              data-paused
              class="group hover:scale-110 transition-all duration-(--transition) active:scale-95"
              aria-label="Play"
              title="Play"
            >
              <Icon
                name="tabler:player-play"
                class="hidden group-data-paused:block w-6 lg:w-8 text-magenta-900"
              />
              <Icon
                name="tabler:player-pause"
                class="group-data-paused:hidden w-6 lg:w-8 text-magenta-900"
              />
            </button>

            <button
              id="toggle-mute"
              type="button"
              data-muted
              class="group hover:scale-110 transition-all duration-(--transition) active:scale-95"
              aria-label="Unmute"
              title="Unmute"
            >
              <Icon
                name="tabler:volume-off"
                class="hidden group-data-muted:block w-6 lg:w-8 text-magenta-900"
              />
              <Icon
                name="tabler:volume"
                class="group-data-muted:hidden w-6 lg:w-8 text-magenta-900"
              />
            </button>
          </div>
        )
      }
    </div>

    <!-- Below the video on mobile, overlaid from md up -->
    <header class="md:absolute md:top-1/2 md:left-0 md:-translate-y-1/2 z-10">
      <h1
        class="text-2xl md:text-3xl lg:text-4xl mb-2 lg:mb-4 uppercase drop-shadow-lg lsa lsa-slide-up no-repeat"
      >
        {post.data.title}
      </h1>
      <p
        class="text-base lg:text-s drop-shadow-lg lsa lsa-slide-up no-repeat delay-200"
      >
        {post.data.year}
      </p>
    </header>
  </div>

  <main>
    <section id="work-details" class="lsa no-repeat pt-4 pb-8">
      <div
        id="info-details"
        class="w-full md:grid md:grid-cols-[1fr_4fr] items-start gap-4 lg:gap-8 border-t border-b py-4 md:py-6 cursor-pointer"
      >
        <button
          type="button"
          class="flex items-center gap-3"
          aria-label="Show/Hide Info"
          title="Show/Hide Info"
        >
          <Icon
            data-info-icon
            name="tabler:plus"
            class="w-10 h-10 shrink-0 bg-white text-black rounded-full p-2 rotate-45 hover:scale-105 active:scale-95 transition duration-(--transition)"
          />
          <h2
            class="px-4 py-1 bg-magenta-900 text-xs uppercase text-white rounded-full"
          >
            info
          </h2>
        </button>

        <div
          id="info-content"
          class="active h-0 opacity-0 overflow-hidden transition duration-(--transition) [.active]:h-auto [.active]:mt-4 [.active]:md:mt-0 [.active]:opacity-100"
        >
          {
            post.data.info.map((item: string) => (
              <p class="mb-4" set:html={item} />
            ))
          }
        </div>
      </div>

      <div
        id="credits-details"
        class="w-full md:grid md:grid-cols-[1fr_4fr] items-start gap-4 lg:gap-8 border-b py-4 md:py-6 cursor-pointer"
      >
        <button
          type="button"
          class="flex items-center gap-3"
          aria-label="Show/Hide Credits"
          title="Show/Hide Credits"
        >
          <Icon
            data-credits-icon
            name="tabler:plus"
            class="w-10 h-10 shrink-0 bg-white text-black rounded-full p-2 hover:scale-105 active:scale-95 transition duration-(--transition)"
          />
          <h2
            class="px-4 py-1 bg-magenta-900 text-xs uppercase text-white rounded-full"
          >
            credits
          </h2>
        </button>

        <div
          id="credits-content"
          class="h-0 opacity-0 overflow-hidden transition duration-(--transition) [.active]:h-auto [.active]:mt-4 [.active]:md:mt-0 [.active]:opacity-100"
        >
          {
            post.data.credits?.map((item: string) => (
              <div set:html={item} class="flex flex-col gap-8 mb-4" />
            ))
          }
        </div>
      </div>
    </section>

    <section
      id="work-gifs"
      class="lsa-stagger grid md:grid-cols-2 md:gap-x-10 gap-y-8 md:gap-y-12"
    >
      {
        post.data.gifs.gallery?.map((gif: string) => (
          <article class="relative pb-[56.25%] h-0 rounded-xl overflow-hidden lsa lsa-slide-up no-repeat">
            <mux-player
              playback-id={gif}
              accent-color="var(--color-magenta-900)"
              class="w-full"
              style="--controls: none;"
              loop
              muted
              autoplay
            />
          </article>
        ))
      }

      {
        post.data.images?.map((image) => (
          <Picture
            src={image}
            alt={post.data.title}
            formats={["avif", "webp"]}
            class="aspect-video object-cover lsa lsa-slide-up no-repeat"
          />
        ))
      }
    </section>

    <Pagination
      prevPost={prevPost}
      nextPost={nextPost}
      prevPostSlug={`/work/${prevPost?.id}`}
      nextPostSlug={`/work/${nextPost?.id}`}
      prevPostTitle={prevPost?.data.title}
      nextPostTitle={nextPost?.data.title}
    />
  </main>
</Layout>

<script>
  const heroVideo = document.getElementById(
    "hero-video",
  ) as HTMLVideoElement | null;
  const infoDetails = document.querySelector(`#info-details`) as Element;
  const infoContent = document.querySelector(`#info-content`) as HTMLElement;
  const infoIcon = document.querySelector(`[data-info-icon]`) as Element;
  const creditsDetails = document.querySelector(`#credits-details`) as Element;
  const creditsContent = document.querySelector(
    `#credits-content`,
  ) as HTMLElement;
  const creditsIcon = document.querySelector(`[data-credits-icon]`) as Element;

  // Hero video: autoplay unless reduced motion; controls follow player state
  function setupHeroVideo(player: HTMLVideoElement) {
    const togglePlay = document.getElementById("toggle-play") as HTMLElement;
    const toggleMute = document.getElementById("toggle-mute") as HTMLElement;

    // Rejects when autoplay is blocked; the still and Play button stay up
    const playVideo = () => player.play().catch(() => {});

    const setLabel = (button: HTMLElement, label: string) => {
      button.setAttribute("aria-label", label);
      button.title = label;
    };
    const syncPlayback = () => {
      togglePlay.toggleAttribute("data-paused", player.paused);
      setLabel(togglePlay, player.paused ? "Play" : "Pause");
    };
    const syncVolume = () => {
      toggleMute.toggleAttribute("data-muted", player.muted);
      setLabel(toggleMute, player.muted ? "Unmute" : "Mute");
    };

    // Fade in over the still once frames are rendering
    player.addEventListener(
      "playing",
      () => player.setAttribute("data-playing", ""),
      { once: true },
    );
    player.addEventListener("play", syncPlayback);
    player.addEventListener("pause", syncPlayback);
    player.addEventListener("volumechange", syncVolume);

    togglePlay.addEventListener("click", () =>
      player.paused ? playVideo() : player.pause(),
    );
    toggleMute.addEventListener("click", () => {
      player.muted = !player.muted;
    });

    syncPlayback();
    syncVolume();
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      playVideo();
    }
  }

  // Show/hide details and handle icon rotation
  function handleShowHideDetails(icon: Element, content: HTMLElement) {
    icon.classList.toggle("rotate-45");
    content.classList.toggle("active");
  }

  infoDetails?.addEventListener("click", () =>
    handleShowHideDetails(infoIcon, infoContent),
  );
  creditsDetails?.addEventListener("click", () =>
    handleShowHideDetails(creditsIcon, creditsContent),
  );
  if (heroVideo) {
    customElements
      .whenDefined("mux-player")
      .then(() => setupHeroVideo(heroVideo));
  }
</script>
