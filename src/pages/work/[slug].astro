---
import { Picture } from 'astro:assets'
import { getCollection } from 'astro:content'
import type { InferGetStaticPropsType } from 'astro'
import { Icon } from 'astro-icon/components'
import CoverVideo from '../../components/media/CoverVideo.astro'
import Pagination from '../../components/ui/Pagination.astro'
import Pill from '../../components/ui/Pill.astro'
import Layout from '../../layouts/Layout.astro'
import { TWO_COLUMN_SIZES } from '../../lib/images'
import { socialImageFrom } from '../../lib/socialImage'
import { getAlphabetizedWorkByYear, getWorkYearsDescending } from '../../lib/sortWork'
import { toMetaDescription } from '../../lib/text'

export async function getStaticPaths() {
  const allPosts = await getCollection('work')

  // Build sorted list by year (newest first), then alphabetically within each year.
  // Years are derived from the content so no entry can be missed.
  const sortedPosts = getWorkYearsDescending(allPosts).flatMap((year) =>
    getAlphabetizedWorkByYear({ allWork: allPosts, year }),
  )

  return sortedPosts.map((post, index) => ({
    params: {
      slug: post.id,
    },
    props: {
      post,
      prevPost: sortedPosts[index - 1],
      nextPost: sortedPosts[index + 1],
    },
  }))
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>

const { post, prevPost, nextPost } = Astro.props
const socialImage = post.data.thumbnail && (await socialImageFrom(post.data.thumbnail))
const description = toMetaDescription(post.data.info[0])
const url = new URL(Astro.url.pathname, Astro.site).href

const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${url}#work`,
    name: post.data.title,
    description,
    url,
    image: socialImage && new URL(socialImage.src, Astro.site).href,
    dateCreated: post.data.year,
    creator: { '@id': `${Astro.site}#organization` },
  },
]
---

<Layout
  title={`${post.data.title} | Work`}
  description={description}
  socialImage={socialImage}
  socialImageAlt={post.data.title}
  ogType="article"
  schema={schema}
>
  <!-- Media runs edge to edge, capped at the viewport's height; the title and controls stay in the content column -->
  <div class="relative lsa-load">
    <div class="relative aspect-video max-h-svh w-full after:content-[''] after:absolute after:inset-0 after:bg-linear-to-b after:from-transparent after:to-black after:pointer-events-none">
      {post.data.gifs.videoHero ? (
        <CoverVideo
          id="hero-video"
          playbackId={post.data.gifs.videoHero}
          eager
          sizes="100vw"
          tracking
          title={`Supervoid Work Page: ${post.data.title}`}
          class="size-full"
        />
      ) : post.data.gifs.imageHero ? (
        /* Above-the-fold hero: the LCP element, so fetch it immediately */
        <Picture
          src={post.data.gifs.imageHero}
          formats={['avif']}
          fallbackFormat="webp"
          sizes="100vw"
          alt=""
          loading="eager"
          fetchpriority="high"
          class="absolute top-0 left-0 w-full h-full object-cover"
        />
      ) : null}

      {post.data.gifs.videoHero && (
        <div class="absolute inset-x-0 bottom-4 md:bottom-8 max-w-screen-2xl mx-auto px-4 md:px-8 flex flex-col lg:flex-row items-end lg:justify-end gap-4 lg:gap-6 z-10 pointer-events-none *:pointer-events-auto">
          <button
            id="toggle-play"
            type="button"
            data-paused
            class="group hover:scale-110 transition-all duration-(--transition) active:scale-95"
            aria-label="Play"
            title="Play"
          >
            <Icon
              name="tabler:player-play"
              class="hidden group-data-paused:block w-6 lg:w-8 text-magenta"
            />
            <Icon
              name="tabler:player-pause"
              class="group-data-paused:hidden w-6 lg:w-8 text-magenta"
            />
          </button>

          <button
            id="toggle-mute"
            type="button"
            data-muted
            class="group hover:scale-110 transition-all duration-(--transition) active:scale-95"
            aria-label="Unmute"
            title="Unmute"
          >
            <Icon
              name="tabler:volume-off"
              class="hidden group-data-muted:block w-6 lg:w-8 text-magenta"
            />
            <Icon name="tabler:volume" class="group-data-muted:hidden w-6 lg:w-8 text-magenta" />
          </button>
        </div>
      )}
    </div>

    <!-- Below the video on mobile, overlaid from md up -->
    <header class="md:absolute md:top-1/2 md:inset-x-0 md:-translate-y-1/2 z-10">
      <h1 class="text-2xl md:text-3xl lg:text-4xl mb-2 lg:mb-4 uppercase drop-shadow-lg lsa lsa-slide-up no-repeat">
        {post.data.title}
      </h1>
      <p class="text-base lg:text-s drop-shadow-lg lsa lsa-slide-up no-repeat delay-200">
        {post.data.year}
      </p>
    </header>
  </div>

  <div class="page-body">
    <section id="work-details" class="lsa no-repeat pt-4 pb-8">
      <details
        open
        class="group w-full md:grid md:grid-cols-[1fr_4fr] items-start gap-4 lg:gap-8 border-b py-4 md:py-6 border-t"
      >
        <summary class="flex items-center gap-3 w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <Icon
            name="tabler:plus"
            class="w-10 h-10 shrink-0 bg-white text-black rounded-full p-2 group-open:rotate-45 hover:scale-105 active:scale-95 transition duration-(--transition)"
          />
          <Pill as="h2">info</Pill>
        </summary>

        <div class="flex flex-col gap-4 pt-4 md:pt-0 pb-4">
          {post.data.info.map((item) => (
            <p set:html={item} />
          ))}
        </div>
      </details>

      <details class="group w-full md:grid md:grid-cols-[1fr_4fr] items-start gap-4 lg:gap-8 border-b py-4 md:py-6">
        <summary class="flex items-center gap-3 w-fit cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <Icon
            name="tabler:plus"
            class="w-10 h-10 shrink-0 bg-white text-black rounded-full p-2 group-open:rotate-45 hover:scale-105 active:scale-95 transition duration-(--transition)"
          />
          <Pill as="h2">credits</Pill>
        </summary>

        <dl class="flex flex-col gap-8 pt-4 md:pt-0 pb-4">
          {post.data.credits?.map(({ role, names }) => (
            <div class="flex flex-col gap-4">
              <dt class="font-header text-s uppercase text-balance">{role}:</dt>
              <dd class="max-w-[65ch] text-xs text-pretty text-grey">{names}</dd>
            </div>
          ))}
        </dl>
      </details>
    </section>

    <section id="work-gifs" class="lsa-stagger grid md:grid-cols-2 md:gap-x-10 gap-y-8 md:gap-y-12">
      {post.data.gifs.gallery?.map((gif) => (
        <CoverVideo
          playbackId={gif}
          sizes={TWO_COLUMN_SIZES}
          class="aspect-video rounded-xl overflow-hidden lsa lsa-slide-up no-repeat"
        />
      ))}

      {post.data.images?.map((image) => (
        <Picture
          src={image}
          sizes={TWO_COLUMN_SIZES}
          alt=""
          formats={['avif']}
          fallbackFormat="webp"
          class="aspect-video object-cover lsa lsa-slide-up no-repeat"
        />
      ))}
    </section>

    <Pagination
      prev={prevPost && { href: `/work/${prevPost.id}/`, title: prevPost.data.title }}
      next={nextPost && { href: `/work/${nextPost.id}/`, title: nextPost.data.title }}
    />
  </div>
</Layout>

<script>
  // Hero controls: Play/Pause and Mute/Unmute follow the player's state. CoverVideo
  // starts and stops the clip as it scrolls in and out of view.
  const heroVideo = document.getElementById('hero-video') as HTMLVideoElement | null

  function setupHeroControls(player: HTMLVideoElement) {
    const togglePlay = document.getElementById('toggle-play') as HTMLElement
    const toggleMute = document.getElementById('toggle-mute') as HTMLElement

    const setLabel = (button: HTMLElement, label: string) => {
      button.setAttribute('aria-label', label)
      button.title = label
    }
    const syncPlayback = () => {
      togglePlay.toggleAttribute('data-paused', player.paused)
      setLabel(togglePlay, player.paused ? 'Play' : 'Pause')
    }
    const syncVolume = () => {
      toggleMute.toggleAttribute('data-muted', player.muted)
      setLabel(toggleMute, player.muted ? 'Unmute' : 'Mute')
    }

    player.addEventListener('play', syncPlayback)
    player.addEventListener('pause', syncPlayback)
    player.addEventListener('volumechange', syncVolume)

    // A pause from this button sticks: scrolling back into view won't restart it
    togglePlay.addEventListener('click', () => {
      player.toggleAttribute('data-user-paused', !player.paused)
      if (player.paused) player.play().catch(() => {})
      else player.pause()
    })
    toggleMute.addEventListener('click', () => {
      player.muted = !player.muted
    })

    syncPlayback()
    syncVolume()
  }

  if (heroVideo) {
    customElements.whenDefined('mux-video').then(() => setupHeroControls(heroVideo))
  }
</script>
