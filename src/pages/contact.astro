---
import { Icon } from 'astro-icon/components'
import Button from '../components/ui/Button.astro'
import Layout from '../layouts/Layout.astro'
import { EMAIL, mailto } from '../lib/site'

// 16px and up on phones, so iOS doesn't zoom the page when a field is focused
const fieldClass =
  'w-full px-4 py-3 bg-black text-white focus:shadow-offset ring-1 ring-inset ring-white focus:ring-2 focus:ring-inset focus:ring-magenta-900 rounded-lg transition duration-(--transition) outline-none text-base md:text-xs'
const labelClass = 'block mb-2 text-left'
---

<Layout
  title="Contact"
  description="Get in touch with SUPERVOID. We are always looking to collaborate with innovative creators and brands."
>
  <header class="pt-[calc(var(--nav-height)+6rem)] lsa-load lsa-slide-up">
    <h1 class="text-xl mb-4 drop-shadow-lg text-center uppercase">Contact Us</h1>
  </header>

  <div class="page-body">
    <section class="text-center lsa-load lsa-slide-up [animation-delay:300ms]">
      <h2 class="text-l uppercase text-center mb-8">Let's Get Started</h2>

      <form
        method="POST"
        name="contactForm"
        action="/success/"
        class="max-w-2xl mx-auto flex flex-col gap-4"
        data-netlify="true"
      >
        <div class="w-full flex flex-col md:flex-row gap-4 justify-between">
          <div class="w-full">
            <label for="first-name" class={labelClass}>
              First Name
            </label>
            <input
              type="text"
              name="first-name"
              id="first-name"
              autocomplete="given-name"
              required
              class={fieldClass}
            />
          </div>

          <div class="w-full">
            <label for="last-name" class={labelClass}>
              Last Name <span class="text-grey-100">(Optional)</span>
            </label>
            <input
              type="text"
              name="last-name"
              id="last-name"
              autocomplete="family-name"
              class={fieldClass}
            />
          </div>
        </div>

        <div>
          <label for="email" class={labelClass}>
            Email
          </label>
          <input
            type="email"
            name="email"
            id="email"
            autocomplete="email"
            required
            class={fieldClass}
          />
        </div>

        <div>
          <label for="project-timeline" class={labelClass}>
            Project Timeline
          </label>
          <div class="relative">
            <select
              name="project-timeline"
              id="project-timeline"
              required
              class:list={[fieldClass, 'block appearance-none text-grey-100']}
              onchange="this.classList.toggle('text-grey-100', this.value === '')"
            >
              <option value="" selected disabled hidden>
                Choose one
              </option>
              <option value="1-3 months">1-3 months</option>
              <option value="3-6 months">3-6 months</option>
              <option value="6-12 months">6-12 months</option>
              <option value="1 year+">1 year+</option>
            </select>

            <Icon
              name="tabler:chevron-down"
              class="size-8 pointer-events-none text-grey-100 absolute right-3 top-1/2 transform -translate-y-1/2"
            />
          </div>
        </div>

        <div>
          <label for="message" class={labelClass}>
            Describe Your Project
          </label>
          <textarea name="message" id="message" rows="4" required class={fieldClass}></textarea>
        </div>

        <Button type="submit" text="Send Message" class="mx-auto" />
      </form>
    </section>

    <section id="general-inquiries" class="text-center lsa lsa-slide-up no-repeat delay-300">
      <h2 class="text-l uppercase text-center mb-4">General Inquiries</h2>
      <a href={mailto('General Inquiry')} class="flex justify-center items-center gap-4 text-xs">
        <Icon name="tabler:mail" class="w-8 h-8 text-magenta-900" />
        {EMAIL}
      </a>
    </section>
  </div>
</Layout>
