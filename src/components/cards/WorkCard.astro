---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { TWO_COLUMN_SIZES } from '../../lib/images'

export interface Props {
  work: CollectionEntry<'work'>
  /** Skip the scroll observer and animate from CSS on first paint. */
  isAboveTheFold?: boolean
  /** Fetch the image ahead of everything else: the page's first card is its LCP. */
  priority?: boolean
}

const { work, isAboveTheFold = false, priority = false } = Astro.props
const { id } = work
const imageHero = work.data.thumbnail
const videoTitle = work.data.title
const cardId = `work-preview-card-${id}`
---

<article
  id={cardId}
  class:list={[
    'work-preview-card relative w-full h-0 max-w-screen-2xl mx-auto pb-[56.25%] rounded-xl overflow-hidden group lsa-slide-up',
    // The link's box is empty (everything in it is positioned), so the focus ring goes on the card
    'has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-4 has-[a:focus-visible]:outline-magenta-900',
    isAboveTheFold ? 'lsa-load' : 'lsa no-repeat',
  ]}
>
  <a href={`/work/${id}/`} class="outline-none">
    {imageHero ? (
      <Picture
        src={imageHero}
        alt=""
        formats={['avif', 'webp']}
        sizes={TWO_COLUMN_SIZES}
        loading={isAboveTheFold ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        class="absolute top-0 left-0 w-full h-full object-cover brightness-75 group-hocus:brightness-100 group-hocus:scale-105 transition duration-(--transition)"
      />
    ) : null}

    <div class="absolute bottom-0 flex items-center gap-3 w-full">
      <h3 class="bg-magenta-900 text-xs uppercase text-black rounded-full px-4 py-1">
        {videoTitle}
      </h3>
    </div>
  </a>
</article>
