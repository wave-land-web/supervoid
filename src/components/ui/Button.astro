---
export interface Props {
  text: string
  href: string
  class?: string
}

const { text, href, class: className } = Astro.props
---

<a
  href={href}
  class:list={[
    className,
    'block py-2 px-8 max-w-fit border-2 border-magenta-900 rounded-full hover:shadow-[4px_4px_0_var(--color-magenta-900)] text-magenta-900 hover:text-magenta-900 active:translate-x-1 active:translate-y-1 active:shadow-none text-s transition duration-(--transition)',
  ]}
>
  {text}
</a>
