---
/** A ruled row: a small label on the left, its content in the wide column from `md` up. */
export interface Props {
  label: string
  class?: string
}

const { label, class: className } = Astro.props
---

<div class:list={['w-full grid md:grid-cols-[1fr_4fr] gap-4 lg:gap-8 py-6 border-t', className]}>
  <h2 class="text-base uppercase">{label}</h2>
  <slot />
</div>
