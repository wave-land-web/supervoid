---
import PageLink from './PageLink.astro'

interface Link {
  href: string
  title: string
}

export interface Props {
  prev?: Link
  next?: Link
}

const { prev, next } = Astro.props
---

<section id="pagination" class="pagination flex flex-col md:flex-row justify-between gap-4 pt-0">
  {prev && <PageLink href={prev.href} title={prev.title} text="Previous" direction="left" />}
  {next && <PageLink href={next.href} title={next.title} text="Next" direction="right" />}
</section>
