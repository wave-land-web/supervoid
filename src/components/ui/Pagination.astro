---
import AnimatedCTA from '../text/AnimatedCTA.astro'

interface PageLink {
  href: string
  title: string
}

export interface Props {
  prev?: PageLink
  next?: PageLink
}

const { prev, next } = Astro.props
---

<section id="pagination" class="pagination flex flex-col md:flex-row justify-between gap-4 pt-0">
  {prev && <AnimatedCTA href={prev.href} title={prev.title} text="Previous" direction="left" />}
  {next && <AnimatedCTA href={next.href} title={next.title} text="Next" direction="right" />}
</section>
