---
import { Picture } from 'astro:assets'

export interface Props {
  title: string
  image: ImageMetadata
  imageAlt: string
}

const { title, image, imageAlt } = Astro.props
---

<header class="px-0 pt-[calc(var(--nav-height)+4rem)] md:pt-[calc(var(--nav-height)+6rem)] lsa-load lsa-slide-up">
  <div class="relative">
    <h1 class="absolute w-full top-[-0.5lh] left-1/2 -translate-x-1/2 text-l drop-shadow-lg text-center uppercase">
      {title}
    </h1>
    <Picture src={image} formats={['avif', 'webp']} alt={imageAlt} loading="eager" />
  </div>
</header>
