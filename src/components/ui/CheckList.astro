---
import { Icon } from 'astro-icon/components'

export interface Props {
  items: string[]
  class?: string
}

const { items, class: className } = Astro.props
---

<!-- Each tick is one line tall, so it sits on the first line of a wrapped item -->
<ul class:list={['flex flex-col gap-4', className]}>
  {items.map((item) => (
    <li class="flex items-start gap-4">
      <Icon name="tabler:check" class="size-[1lh] shrink-0 text-magenta" aria-hidden="true" />
      {item}
    </li>
  ))}
</ul>
