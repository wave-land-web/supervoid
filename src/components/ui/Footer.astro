---
import { Icon } from 'astro-icon/components'
import { EMAIL } from '../../lib/site'
import SocialIcons from './SocialIcons.astro'
---

<footer class="w-full max-w-screen-2xl m-auto p-8 fixed bottom-0 left-1/2 transform -translate-x-1/2">
  <div id="footer-contact" class="flex flex-col items-center gap-4 mb-28">
    <p class="text-base no-underline">{EMAIL}</p>
    <SocialIcons />
  </div>
  <div id="footer-info" class="flex flex-col md:flex-row justify-between items-center gap-4">
    <p>Supervoid © {new Date().getFullYear()}</p>
    <p>
      Website by{' '}
      <a
        href="https://wavelandweb.com"
        target="_blank"
        rel="noopener noreferrer"
        class="site-link inline-flex items-center gap-1"
      >
        Wave Land Web <Icon name="tabler:arrow-up-right" class="w-[clamp(1rem,2vw,1.5rem)]" />
      </a>
    </p>
  </div>
</footer>

<script>
  // The footer sits under the page and is only uncovered at the very bottom. When
  // keyboard focus lands in it, scroll there so the focused link isn't hidden.
  document.querySelector('footer')?.addEventListener('focusin', () => {
    window.scrollTo({ top: document.documentElement.scrollHeight })
  })
</script>
