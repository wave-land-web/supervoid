---
import { Picture } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { TWO_COLUMN_SIZES } from '../../lib/images'

export interface Props {
  post: CollectionEntry<'press'>
  isAboveTheFold: boolean
  /** Fetch the image ahead of everything else: the page's first card is its LCP. */
  priority?: boolean
}

const { post, isAboveTheFold, priority = false } = Astro.props
---

<article
  class:list={[
    'lsa-slide-up group',
    // Cards in the fold animate from CSS so they don't wait on the observer
    isAboveTheFold ? 'lsa-load' : 'lsa no-repeat',
  ]}
>
  <a href={`/press/${post.id}/`} class="block rounded-xl">
    <div class="mb-4 h-[clamp(250px,30vw,400px)] overflow-hidden rounded-xl">
      <Picture
        src={post.data.image}
        alt={post.data.imageAlt}
        formats={['avif', 'webp']}
        sizes={TWO_COLUMN_SIZES}
        loading={isAboveTheFold ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        class="brightness-75 group-hocus:brightness-100 group-hocus:scale-105 transition duration-(--transition) w-full h-full object-cover"
      />
    </div>
    <h2 class="mb-2 text-s">{post.data.title}</h2>
  </a>
</article>
